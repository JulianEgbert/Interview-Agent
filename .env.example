LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional prototype tuning.
INTERVIEWROOM_AGENT_NAME=interview-room-agent
INTERVIEWROOM_LLM_MODEL=openai/gpt-5.2-chat-latest
INTERVIEWROOM_STT_MODEL=deepgram/nova-3
INTERVIEWROOM_TTS_MODEL=cartesia/sonic-3
INTERVIEWROOM_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Optional challenge selection. Leave blank to choose a random local challenge.
# INTERVIEWROOM_CHALLENGE_ID=minimum-meeting-rooms
# INTERVIEWROOM_CHALLENGE_TYPE=coding
# INTERVIEWROOM_CHALLENGE_DIFFICULTY=new-grad
# INTERVIEWROOM_CHALLENGE_CATEGORY=graphs
# INTERVIEWROOM_CHALLENGE_TAGS=dfs,connected-components
# INTERVIEWROOM_CHALLENGE_SEED=demo

# Optional local coding workspace.
# Generated challenge folders live under candidate_workspace by default.
# INTERVIEWROOM_WORKSPACE_DIR=candidate_workspace
# INTERVIEWROOM_RESET_WORKSPACE=false
